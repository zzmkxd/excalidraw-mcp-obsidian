{
  "name": "excalidraw-mcp-obsidian",
  "version": "0.1.0",
  "description": "MCP server for AI agents to create and edit Excalidraw diagrams as Obsidian-compatible files — no browser canvas required",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "excalidraw-mcp-obsidian": "dist/index.js"
  },
  "scripts": {
    "start": "npm run build:server && node dist/index.js",
    "build": "npm run build:server",
    "dev": "npx tsc --watch",
    "build:server": "npx tsc && node scripts/copy-templates.mjs",
    "build:types": "npx tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bind": "npm run build:server && node scripts/check-local-bind.mjs",
    "smoke:staging": "npm run build:server && node scripts/smoke-export-staging.mjs",
    "smoke:verify": "node scripts/verify-staging-smokes.mjs",
    "smoke:all": "npm run smoke:staging && npm run smoke:verify",
    "soak:faithful": "npm run build:server && node scripts/soak-template-faithful.mjs",
    "soak:vault": "npm run build:server && node scripts/soak-vault-themes.mjs",
    "type-check": "npx tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "dotenv": "^16.3.1",
    "lz-string": "^1.5.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20.19.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "excalidraw",
    "obsidian",
    "model-context-protocol",
    "ai",
    "diagrams",
    "cursor",
    "claude"
  ],
  "author": "zzmkxd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzmkxd/excalidraw-mcp-obsidian.git"
  },
  "homepage": "https://github.com/zzmkxd/excalidraw-mcp-obsidian#readme",
  "bugs": {
    "url": "https://github.com/zzmkxd/excalidraw-mcp-obsidian/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ]
}
